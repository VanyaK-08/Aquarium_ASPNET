@model Aquarium_Manager.ViewModels.Exhibit.ExhibitDeleteViewModel

@{
    ViewData["Title"] = "Изтриване на изложба";
}

<h1>Изтриване на изложба</h1>

<h3>Сигурни ли сте, че искате да изтриете тази изложба?</h3>

<div>
    <hr />

    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Name)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Name)
        </dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />

        <button type="submit" class="btn btn-danger">Изтрий</button>
        |
        <a asp-action="Index">Назад към списъка</a>
    </form>
</div>

