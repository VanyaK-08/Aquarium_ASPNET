@model IEnumerable<Aquarium_Manager.ViewModels.Fish.FishIndexViewModel>

@{
    ViewData["Title"] = "Fish";
}

<h1>Fish</h1>

<p>
    <a asp-action="Create">Create New Fish</a> |
    <a asp-controller="Tank"
       asp-action="Index">
        Back to Tanks
    </a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>

            <th>
                @Html.DisplayNameFor(model => model.Species)
            </th>

            <th>
                @Html.DisplayNameFor(model => model.Age)
            </th>

            <th>
                @Html.DisplayNameFor(model => model.TankId)
            </th>

            <th></th>
        </tr>
    </thead>

    <tbody>

        @foreach (var fish in Model)
        {
            <tr>

                <td>
                    @Html.DisplayFor(modelItem => fish.Name)
                </td>

                <td>
                    @Html.DisplayFor(modelItem => fish.Species)
                </td>

                <td>
                    @Html.DisplayFor(modelItem => fish.Age)
                </td>

                <td>
                    @Html.DisplayFor(modelItem => fish.TankId)
                </td>

                <td>

                    <a asp-action="Edit"
                       asp-route-id="@fish.Id">
                        Edit
                    </a>

                    |

                    <a asp-action="Details"
                       asp-route-id="@fish.Id">
                        Details
                    </a>

                    |

                    <a asp-action="Delete"
                       asp-route-id="@fish.Id">
                        Delete
                    </a>

                </td>

            </tr>
        }

    </tbody>
</table>
