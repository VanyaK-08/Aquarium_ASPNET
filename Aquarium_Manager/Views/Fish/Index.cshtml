@model IEnumerable<Aquarium_Manager.ViewModels.Fish.FishIndexViewModel>

@{
    ViewData["Title"] = "Fish";
}

<h1>Fish</h1>

<p>
    <a asp-action="Create">Create New Fish</a> |
    <a asp-controller="Tank"
       asp-action="Index">
        Back to Tanks
    </a>
</p>

<div class="row mb-3">
    <div class="col-md-3">
        <label>Fish Name</label>
        <input type="text"
               id="search"
               class="form-control"
               placeholder="Search by name..." />
    </div>

    <div class="col-md-3">
        <label>Species</label>
        <input type="text"
               id="speciesFilter"
               class="form-control"
               placeholder="Enter species..." />
    </div>

    <div class="col-md-3">
        <label>Sort By</label>
        <select id="sortOrder" class="form-control">
            <option value="name" selected>Name A-Z</option>
            <option value="species">Species A-Z</option>
            <option value="age_asc">Age Ascending</option>
            <option value="age_desc">Age Descending</option>
        </select>
    </div>

    <div class="col-md-3 d-flex align-items-end">
        <button type="button" id="clearFilters"
                class="btn btn-primary">
            Clear Filters
        </button>
    </div>

</div>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>

            <th>
                @Html.DisplayNameFor(model => model.Species)
            </th>

            <th>
                @Html.DisplayNameFor(model => model.Age)
            </th>

            <th>
                @Html.DisplayNameFor(model => model.TankId)
            </th>

            <th></th>
        </tr>
    </thead>

    <tbody id="fishTable">

        @foreach (var fish in Model)
        {
            <tr>

                <td>
                    @Html.DisplayFor(modelItem => fish.Name)
                </td>

                <td>
                    @Html.DisplayFor(modelItem => fish.Species)
                </td>

                <td>
                    @Html.DisplayFor(modelItem => fish.Age)
                </td>

                <td>
                    @Html.DisplayFor(modelItem => fish.TankId)
                </td>

                <td>

                    <a asp-action="Edit"
                       asp-route-id="@fish.Id">
                        Edit
                    </a>

                    |

                    <a asp-action="Details"
                       asp-route-id="@fish.Id">
                        Details
                    </a>

                    |

                    <a asp-action="Delete"
                       asp-route-id="@fish.Id">
                        Delete
                    </a>

                </td>

            </tr>
        }

    </tbody>
</table>

@section Scripts {
    <script src="~/js/FishFilter.js"
            asp-append-version="true">
    </script>
}