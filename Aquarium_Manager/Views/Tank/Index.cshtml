@model IEnumerable<Aquarium_Manager.ViewModels.Tank.TankIndexViewModel>

@{
    ViewData["Title"] = "Index";
}

<h1>Tanks</h1>

<p>
    <a asp-action="Create">Create New Tank</a> |
    <a asp-controller="Fish"
       asp-action="Index">
        View Fish
    </a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Volume)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Location)
            </th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Name)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Volume)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Location)
                </td>
                <td>
                    <a asp-controller="Tank"
                       asp-action="Edit"
                       asp-route-id="@item.Id">
                        Edit
                    </a> |

                    <a asp-controller="Tank"
                       asp-action="Details"
                       asp-route-id="@item.Id">
                        Details
                    </a> |

                    <a asp-controller="Tank"
                       asp-action="Delete"
                       asp-route-id="@item.Id">
                        Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
