@model IEnumerable<Aquarium_Manager.ViewModels.Tank.TankIndexViewModel>

@{
    ViewData["Title"] = "Index";
}

<h1>Tanks</h1>

<p>
    <a asp-action="Create">Create New Tank</a> |
    <a asp-controller="Fish"
       asp-action="Index">
        View Fish
    </a>
</p>

<form asp-controller="Tank" asp-action="Index" method="get">
    <div class="row mb-3">
        <div class="col-md-4">
            <input type="text"
                   name="search"
                   value="@ViewBag.Search"
                   class="form-control"
                   placeholder="Search by name..." />
        </div>

        <div class="col-md-3">
            <label class="form-label">Minimum Volume</label>
            <input type="number"
                   name="minVolume"
                   value="@ViewBag.MinVolume"
                   min="0"
                   class="form-control" />
        </div>

        <div class="col-md-3">
            <label class="form-label">Sort By</label>
            <select name="sortOrder" class="form-control"
               <option value="name"
                   selected = "@(ViewBag.SortOrder == "name")">
                   Name A-Z
               </option>
               <option value="volume_asc"
                   selected = "@(ViewBag.SortOrder == "volume_asc")">
                   Volume Ascending
               </option>
               <option value="volume_desc"
                   selected = "@(ViewBag.SortOrder == "volume_desc")">
                   Volume Descending
               </option>
            </select>
        </div>

        <div class="col-md-2 d-flex align-items-end">
            <button type="submit" class="btn btn-primary">
                Search
            </button>

        </div>
    </div>
</form>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Volume)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Location)
            </th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Name)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Volume)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Location)
                </td>
                <td>
                    <a asp-controller="Tank"
                       asp-action="Edit"
                       asp-route-id="@item.Id">
                        Edit
                    </a> |

                    <a asp-controller="Tank"
                       asp-action="Details"
                       asp-route-id="@item.Id">
                        Details
                    </a> |

                    <a asp-controller="Tank"
                       asp-action="Delete"
                       asp-route-id="@item.Id">
                        Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
